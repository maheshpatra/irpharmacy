{
  "expo": {
    "name": "IR-pharmacy",
    "slug": "irpharmacy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyCmUrU5yuOBzybzwCxhRtqcvVgruuCrvbA"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to provide accurate delivery addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses your location to provide accurate delivery addresses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#fff"
      },
      "package": "com.irpharmacy",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCmUrU5yuOBzybzwCxhRtqcvVgruuCrvbA"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ef958a0c-02f6-4ffc-b8b7-c8091c0994dd"
      }
    }
  }
}